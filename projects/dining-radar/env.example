# projects/dining-radar の実行時環境変数テンプレート。
#
# ファイル名について(meta/adr/0040): 本ファイルは慣習的な `.env.example` ではなく
# `env.example` である。Claude Codeの権限設定は `.env*` を deny しており、deny は
# allowで上書きできず除外構文も無い(実測)。`.env.example` のままだとAIが保守できず、
# 変数の追記漏れが実際に起きた(reservation-frontend、meta/adr/0040)。
#
# 中身の方針(ADR-0002 決定1): 「`.env.example` は変数名と安全な説明だけを置く」。
# 実値(実APIキー・実座標・実レンジ・実ドメイン)はこのファイルにもgitにも一切
# コミットしない――以下は全て空のまま置く。値を設定したい場合は、このファイルの
# 内容を `.env.local` にコピーする(リポジトリルートの `.gitignore` が
# `.env`/`.env.*` を除外済みなのでgit管理外になる)。`manage.py`
# (runserver・check・test等どのコマンドでも)は起動時にこの `.env.local` を
# プロジェクトルート直下(本ファイルと同じ場所)から自動で読み込む――シェルで
# エクスポートする手順は不要。ファイルが無ければ何もしない。シェルで既に設定済みの
# 実環境変数は上書きしない。この読み込みは開発時の利便のためだけであり、本番デプロイは
# WSGIアプリケーション(`wsgi.py`)を使い、このファイルに依存せずデプロイ環境自身が
# 実環境変数を直接供給する想定である。
#
# 網羅性について: このファイルに列挙する変数名は、`src/dining_radar` が実行時に
# `os.environ`(または同義のマッピング引数)から読む変数と一致することを
# `tests/test_structure.py` が機械検証する。新しい環境変数を実装に追加したら、
# 同じ変更でこのファイルに追記しないとL1/L2が落ちる。

# ==== Django ランタイム設定 (src/dining_radar/settings.py) ====

# Djangoの署名(セッション・CSRF等)に使う秘密鍵。必須――未設定だと
# `RuntimeError: DJANGO_SECRET_KEY must be configured at runtime.` で起動が失敗する。
# 取得先は無い(自分で生成する)。例:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# 生成した値は秘密として扱い、このファイル・git・ログ・エラーメッセージに書かない。
DJANGO_SECRET_KEY=

# カンマ区切りの許可ホスト名(Djangoの`ALLOWED_HOSTS`)。例:
# `example.invalid,www.example.invalid`。未設定または空文字だと許可ホストが0件になり、
# 全リクエストが拒否される。実運用の実ドメインを決めるのは配備スライスの範囲であり、
# このテンプレートには実値を書かない。
DJANGO_ALLOWED_HOSTS=

# "1" を設定すると DEBUG=True になり、HTTPS強制リダイレクト
# (`SECURE_SSL_REDIRECT`)が無効になる。未設定時は False(本番相当)。ローカル開発時
# だけ設定し、公開運用では設定しない。
DJANGO_DEBUG=

# Render/Neon deployment only. Neon DashboardのConnection stringをRenderのSecretへ
# 設定する。認証情報を含むため値はgit・ログ・このファイルへ書かない。Renderでは
# 未設定のまま起動すると、揮発するSQLiteへ誤って切り替わらないよう起動を拒否する。
DATABASE_URL=

# Renderが自動設定するプラットフォーム識別子。ローカルでは空のままにする。
# 値が存在すると、TLS終端proxyのX-Forwarded-ProtoをDjangoが信頼する。
RENDER=

# Renderが自動設定する公開ホスト名。settings.pyがALLOWED_HOSTSへ追加する。
# 実ドメインは公開値だが、環境固有なのでこのテンプレートでは空のままにする。
RENDER_EXTERNAL_HOSTNAME=

# 無料RenderにはShellがないため、初回buildだけで個別organizerを作成するwrite-only値。
# 両方をRender Secretとして設定し、初回deployとlogin確認後に削除する。再deploy時に
# 同名accountが既にあればpasswordを変更しない。値はgit・ログへ書かない。
DJANGO_BOOTSTRAP_ORGANIZER_USERNAME=
DJANGO_BOOTSTRAP_ORGANIZER_PASSWORD=

# ==== Hot Pepper グルメサーチAPI (src/dining_radar/integrations/hotpepper/config.py) ====
# ADR-0002 決定2・ADR-0004・ADR-0008: 検索基点(緯度経度)・探索範囲は非公開の
# runtime設定であり、実在の生活圏を示す地名・座標・距離をリポジトリ・設計例・既定値に
# 一切置かない(ADR-0002 決定2)。以下4変数の実値は、このファイル・git・ログ・
# エラーメッセージ・ブラウザのいずれにも出してはならない(Must-not-disclose)。

# Hot Pepper グルメサーチAPIの契約者用APIキー。取得先: リクルートWebサービス
# (https://webservice.recruit.co.jp/)、要契約者登録。必須――未設定だと
# `HotPepperConfigurationError` が実行時(候補検索時)に発生する。実値は秘密として
# 扱う。
HOTPEPPER_API_KEY=

# 検索基点の緯度(10進数)。ADR-0004・ADR-0008が定める非公開の実店舗探索基点
# (自宅・職場等、利用者本人だけが知る値)。必須。実在の生活圏を推測できる値なので
# コミットしない。
HOTPEPPER_SEARCH_LATITUDE=

# 検索基点の経度(10進数)。上記緯度と同じ非公開性が適用される。必須。
HOTPEPPER_SEARCH_LONGITUDE=

# Hot Pepper API自身の`range`パラメータ(providerが定義する不透明な距離帯。本製品は
# ブラウザにレンジ選択を公開しない、ADR-0005 決定4)。未設定時は`config.py`の
# `DEFAULT_SEARCH_RANGE`が使われる。空のままでよい。
HOTPEPPER_SEARCH_RANGE=

# Hot Pepper APIのベースURL。通常は変更不要(未設定時は`config.py`の
# `DEFAULT_BASE_URL`が使われる)。設定する場合はHTTPS必須――HTTPだと実行時に
# `HotPepperConfigurationError`になる。
HOTPEPPER_API_BASE_URL=
