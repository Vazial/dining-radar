{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadTheOneServiceTaskWeReattachFor",
      "Effect": "Allow",
      "Action": "ecs:DescribeTasks",
      "Resource": "arn:aws:ecs:<AWS_REGION>:<AWS_ACCOUNT_ID>:task/dining-radar/*"
    },
    {
      "Sid": "MoveTheOneElasticIpThisServiceOwns",
      "Effect": "Allow",
      "Action": "ec2:AssociateAddress",
      "Resource": "arn:aws:ec2:<AWS_REGION>:<AWS_ACCOUNT_ID>:elastic-ip/<ELASTIC_IP_ALLOCATION_ID>"
    },
    {
      "Sid": "ToAnyNetworkInterfaceInThisAccount",
      "Effect": "Allow",
      "Action": "ec2:AssociateAddress",
      "Resource": "arn:aws:ec2:<AWS_REGION>:<AWS_ACCOUNT_ID>:network-interface/*"
    }
  ]
}
