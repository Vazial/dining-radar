{$PUBLIC_DOMAIN} {
	# Same-task localhost: both containers share one network namespace
	# (awsvpc mode), so this never leaves the task.
	reverse_proxy localhost:8000 {
		header_up X-Forwarded-Proto {scheme}
		header_up Host {host}
	}

	encode zstd gzip
}
